# 复制为 backend/.env 后按需修改；.env 不会被提交到 GitHub。

# 留空则 /api/analyze 自动使用关键词兜底分类器，不影响体验完整性。
OPENAI_API_KEY=

# 兼容 OpenAI Chat Completions 接口格式的模型服务地址，可替换为其他供应商。
AI_BASE_URL=https://api.openai.com/v1

AI_MODEL=gpt-4o-mini

# 模型调用超时时间（秒），超时自动降级为安全兜底问题。
AI_TIMEOUT_SECONDS=10

# 正式前端域名（部署到 GitHub Pages 后填写），多个地址用逗号分隔。
# 本地开发地址已在代码中默认允许，无需在此重复填写。
# 示例：ALLOWED_ORIGINS=https://NiceStone-Hill.github.io
ALLOWED_ORIGINS=
